# RiseBay environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase (browser-safe) ─────────────────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── App config ──────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development

# ────────────────────────────────────────────────────────────────────
# Everything below is a SERVER secret. It is set with
# `supabase secrets set NAME=value`, never in this file's .env.local
# counterpart, and never with a VITE_ prefix (VITE_ ships to browsers).
#
#   STRIPE_SECRET_KEY          Stripe → Developers → API keys (sk_...)
#   STRIPE_WEBHOOK_SECRET      Stripe → Developers → Webhooks (whsec_...)
#   MARKETPLACE_FEE_BPS        Your cut in basis points (800 = 8%)
#   APP_URL                    Public site URL, for Stripe redirect URLs
#
# The Supabase Edge Functions read SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY from the platform automatically.
# ────────────────────────────────────────────────────────────────────
